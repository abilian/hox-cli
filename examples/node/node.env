# The node's parameters, read by create-vm.sh, bootstrap.sh and inventory.py.
# Plain KEY=value lines, shell syntax.

# The node's name: its Host in ssh_config, and its compute node title on the
# master, so also `[node] title` in hox.toml.
NODE=my-node
# SlapOS partitions, one per instance (24 held our 21 applications).
PARTITIONS=24

# For create-vm.sh only: the VM, on a libvirt host reached as root over SSH.
# For a node that isn't such a VM, leave KVM_HOST empty: bootstrap.sh then
# skips create-vm.sh, and the lines below don't matter.
KVM_HOST=root@kvm-host.example.org
VCPUS=4
MEM_GIB=8
DISK_GIB=100
# The libvirt network, and the fixed address the VM gets on it (a DHCP
# reservation for MAC). IP must be ssh_config's HostName.
NETWORK=default
IP=192.168.122.10
MAC=52:54:00:68:6f:78
